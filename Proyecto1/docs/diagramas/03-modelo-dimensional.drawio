<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="03-modelo-dimensional" name="Modelo dimensional SG-Food"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="SG-Food · Modelo dimensional de ventas" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;" vertex="1"><mxGeometry x="55" y="20" width="1100" height="45" as="geometry" /></mxCell><mxCell id="subtitle" parent="1" value="Esquema estrella · entidades publicadas como vistas dbt · relaciones lógicas verificadas mediante pruebas" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;" vertex="1"><mxGeometry x="55" y="65" width="1320" height="30" as="geometry" /></mxCell><mxCell id="cliente" parent="1" value="&lt;b&gt;DIM_CLIENTE&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK lógica: id_cliente&lt;br&gt;250 filas&lt;br&gt;&lt;br&gt;Dimensión de cliente" style="table" vertex="1"><mxGeometry x="70" y="165" width="305" height="155" as="geometry" /></mxCell><mxCell id="producto" parent="1" value="&lt;b&gt;DIM_PRODUCTO&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK lógica: id_producto&lt;br&gt;80 filas&lt;br&gt;&lt;br&gt;Dimensión de producto" style="table" vertex="1"><mxGeometry x="1125" y="165" width="305" height="155" as="geometry" /></mxCell><mxCell id="fecha" parent="1" value="&lt;b&gt;DIM_FECHA&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK lógica: fecha&lt;br&gt;243 días&lt;br&gt;&lt;br&gt;Dimensión calendario" style="table" vertex="1"><mxGeometry x="70" y="495" width="305" height="155" as="geometry" /></mxCell><mxCell id="sucursal" parent="1" value="&lt;b&gt;DIM_SUCURSAL&lt;/b&gt;&lt;br&gt;&lt;br&gt;PK lógica: id_sucursal&lt;br&gt;6 filas&lt;br&gt;&lt;br&gt;Dimensión de sucursal" style="table" vertex="1"><mxGeometry x="1125" y="495" width="305" height="155" as="geometry" /></mxCell><mxCell id="fact" parent="1" value="&lt;b&gt;FACT · FCT_VENTAS_DETALLE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Grano:&lt;/b&gt; una fila por id_detalle de venta&lt;br&gt;3,209 líneas · 14 columnas&lt;br&gt;&lt;br&gt;&lt;b&gt;Claves lógicas:&lt;/b&gt; id_cliente · id_producto&lt;br&gt;fecha · id_sucursal&lt;br&gt;&lt;br&gt;&lt;b&gt;Medidas:&lt;/b&gt; cantidad · precio · descuento · subtotal&lt;br&gt;&lt;br&gt;La fecha, cliente y sucursal vienen de la cabecera; producto y medidas, del detalle." style="fact" vertex="1"><mxGeometry x="520" y="265" width="460" height="300" as="geometry" /></mxCell><mxCell id="note" parent="1" value="NOTA DE IMPLEMENTACIÓN&lt;br&gt;Las cinco entidades del mart son vistas dbt: no tienen PK/FK físicas. Unicidad, integridad referencial y conservación del grano se verifican mediante tests SQL/dbt y reconciliación." style="note" vertex="1"><mxGeometry x="310" y="730" width="880" height="90" as="geometry" /></mxCell><mxCell id="legend" parent="1" value="Relación lógica 1 → N: una fila de dimensión puede asociarse con múltiples filas del hecho. La flecha termina en la dimensión referenciada." style="text;html=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#475569;align=center;verticalAlign=middle;" vertex="1"><mxGeometry x="280" y="835" width="940" height="30" as="geometry" /></mxCell><mxCell id="m1" parent="1" value="id_cliente" style="edge" edge="1" source="fact" target="cliente"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m2" parent="1" value="id_producto" style="edge" edge="1" source="fact" target="producto"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m3" parent="1" value="fecha" style="edge" edge="1" source="fact" target="fecha"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="m4" parent="1" value="id_sucursal" style="edge" edge="1" source="fact" target="sucursal"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>